# Copie para .env e preencha. O .env nunca vai para o Git.

# --- Aplicação ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Chave para assinar a sessão do navegador. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
DATABASE_PATH=data/app.db
TIMEZONE=America/Sao_Paulo
# Intervalo da sincronização automática com o Drive (segundos). 300 = 5 min.
SYNC_INTERVAL_SECONDS=300

# --- Google OAuth / Drive (ver README, seção "Credenciais do Google") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa ser idêntico ao cadastrado no Google Cloud (protocolo, porta, caminho, barra final).
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
# ID da pasta raiz monitorada: o trecho final de https://drive.google.com/drive/folders/<ID>
DRIVE_TEST_FOLDER_ID=

# --- IA (opcional: sem chave, o app funciona em modo determinístico) ---
# gemini | anthropic | none
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Modelo definido na Fase 4, conforme a documentação vigente do Gemini.
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
