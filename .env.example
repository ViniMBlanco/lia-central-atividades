# Copie para .env e preencha. O .env nunca vai para o Git.

# --- Aplicação ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Chave para assinar a sessão do navegador. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
DATABASE_PATH=data/app.db
TIMEZONE=America/Sao_Paulo
# Intervalo da sincronização automática com o Drive (segundos). 300 = 5 min.
SYNC_INTERVAL_SECONDS=300

# --- Google OAuth / Drive (ver README, seção "Credenciais do Google") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa ser idêntico ao cadastrado no Google Cloud (protocolo, porta, caminho, barra final).
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
# ID da pasta raiz monitorada: o trecho final de https://drive.google.com/drive/folders/<ID>
DRIVE_TEST_FOLDER_ID=

# --- IA (opcional: sem chave, as atas são lidas por regras simples, sem IA) ---
# gemini | none
AI_PROVIDER=gemini
# Chave gratuita em https://aistudio.google.com/apikey (camada gratuita: o Google pode usar o
# conteúdo enviado para melhorar seus produtos; use só dados fictícios — veja o README).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tempo máximo de espera por resposta da IA (segundos).
AI_TIMEOUT_SECONDS=90
